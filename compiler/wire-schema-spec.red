Red [
	Title: "Hybrid compiler wire schema specification"
	File:  %wire-schema-spec.red
]

; This is the single source for generated Red and Red/System wire constants.
; Numeric values may change while docs/compiler-wire-format.md is a draft.
compiler-wire-schema-spec: [
	version [
		major 1
		minor 0
	]

	magics [
		RSIR "RSIR"
		RSCF "RSCF"
		RSCG "RSCG"
		RSDG "RSDG"
	]

	enums [
		TARGET [
			NONE 0
			X86_64 1
			ARM64 2
			ARM32 3
			X86 4
		]

		ABI [
			NONE 0
			WIN64 1
			SYSV_X64 2
			AAPCS64 3
			AAPCS32 4
			WIN32 5
		]

		ENDIAN [
			NONE 0
			LITTLE 1
			BIG 2
		]

		SECTION_FLAG [
			OPTIONAL 1
			SORTED 2
			DEDUPLICATED 4
		]

		SECTION_CARDINALITY [
			ANY 0
			ONE 1
			NONEMPTY 2
		]

		RSCF_SECTION [
			CONFIG 1
		]

		RSIR_SECTION [
			MODULE 1
			DATA_LAYOUT 2
			STRINGS 3
			STRING_DATA 4
			FILES 5
			FILE_CHECKSUM_DATA 6
			TYPES 7
			FIELDS 8
			SIGNATURES 9
			PARAMETERS 10
			SYMBOLS 11
			CONSTANTS 12
			CONSTANT_DATA 13
			CONSTANT_PARTS 14
			CONSTANT_BINDINGS 15
			GLOBALS 16
			IMPORTS 17
			EXPORTS 18
			FUNCTIONS 19
			LOCALS 20
			BLOCKS 21
			EDGES 22
			VALUES 23
			INSTRUCTIONS 24
			OPERANDS 25
			CALLS 26
			TARGET_FRAGMENTS 27
			SOURCE_LOCATIONS 28
			EXCEPTION_REGIONS 29
			EXCEPTION_BLOCKS 30
		]

		RSCG_SECTION [
			DATA_LAYOUT 1
			STRINGS 2
			STRING_DATA 3
			OUTPUT_SECTIONS 4
			OUTPUT_DATA 5
			SYMBOLS 6
			RELOCATIONS 7
			IMPORTS 8
			EXPORTS 9
			FUNCTIONS 10
			FILES 11
			FILE_CHECKSUM_DATA 12
			DEBUG_LINES 13
			DEBUG_PARAMETERS 14
			GC_FRAMES 15
			MODULES 16
			UNWIND_FUNCTIONS 17
		]

		RSDG_SECTION [
			STRINGS 1
			STRING_DATA 2
			DIAGNOSTICS 3
		]

		CONFIG_FLAG [
			DEBUG 1
			PIC 2
			DETERMINISTIC 4
		]

		MODULE_KIND [
			RUNTIME 1
			USER 2
			SUPPORT 3
			GLUE 4
		]

		IMAGE_KIND [
			EXECUTABLE 1
			DYNAMIC_LIBRARY 2
		]

		OPTIMIZATION_LEVEL [
			O0 0
			O1 1
			O2 2
		]

		CPU_BASELINE [
			NONE 0
			X86_64_BASE 1
		]

		CHECKSUM_KIND [
			NONE 0
			SHA256 1
		]

		CODE_MODEL [
			SMALL 1
		]

		RELOCATION_MODEL [
			STATIC 1
			PIC 2
		]

		DEBUG_FORMAT [
			NONE 0
			RED 1
		]

		TYPE_KIND [
			VOID 1
			LOGIC 2
			INTEGER 3
			FLOAT 4
			POINTER 5
			FUNCTION 6
			STRUCT 7
			UNION 8
