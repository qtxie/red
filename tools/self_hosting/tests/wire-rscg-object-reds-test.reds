		memory-poisoned? as byte-ptr! modules size? wire-module-lifecycle!
		memory-poisoned? as byte-ptr! view size? wire-rscg-object!
	]
]

test-object: func [
	name [c-string!]
	data [byte-ptr!]
	size [integer!]
	expected-error expected-container expected-string expected-file expected-layout
	expected-module expected-offset expected-section expected-output-count
	expected-output-size expected-symbol-count expected-function-count expected-runtime
	expected-exec expected-bitmap expected-lib [integer!]
	return: [integer!]
	/local result [wire-rscg-object-result!]
		strings [wire-string-table!]
		files [wire-file-source!]
		layout [wire-data-layout!]
		modules [wire-module-lifecycle!]
		view [wire-rscg-object!]
		actual [integer!]
][
	result: declare wire-rscg-object-result!
	strings: declare wire-string-table!
	files: declare wire-file-source!
	layout: declare wire-data-layout!
	modules: declare wire-module-lifecycle!
	view: declare wire-rscg-object!
	poison-outputs strings files layout modules view
	actual: wire-rscg-object-reader/verify data size result strings files layout modules view
	if actual <> expected-error [
		print ["FAIL: " name " expected=" expected-error " actual=" actual lf]
		return 1
	]
	if result/error <> expected-error [return 1]
	if result/container-error <> expected-container [
		print ["FAIL: " name " container=" result/container-error lf]
		return 1
	]
	if result/string-error <> expected-string [return 1]
	if result/file-source-error <> expected-file [return 1]
	if result/data-layout-error <> expected-layout [return 1]
	if result/module-lifecycle-error <> expected-module [
		print ["FAIL: " name " module=" result/module-lifecycle-error lf]
		return 1
	]
	if any [
		result/error-offset <> expected-offset
		result/error-section <> expected-section
	][
		print [
			"FAIL: " name " location=" result/error-offset ":" result/error-section
			" expected=" expected-offset ":" expected-section lf
		]
		return 1
	]
	if expected-error <> WIRE_RSCG_OBJECT_ERROR_SUCCESS [
		unless outputs-poisoned? strings files layout modules view [
			print ["FAIL: " name " modified output views on failure" lf]
			return 1
		]
		return 0
	]
	if any [
		view/output-section-count <> expected-output-count
		view/output-data-size <> expected-output-size
		view/symbol-count <> expected-symbol-count
		view/function-count <> expected-function-count
		view/runtime-module <> expected-runtime
		view/exec-image-symbol <> expected-exec
		view/bitmap-symbol <> expected-bitmap
		view/lib-image-symbol <> expected-lib
		view/output-section-size <> WIRE_RSCG_OUTPUT_SECTION_SIZE
		view/symbol-size <> WIRE_RSCG_SYMBOL_SIZE
		view/function-size <> WIRE_RSCG_FUNCTION_SIZE
	][
		print ["FAIL: " name " verified object view changed" lf]
		return 1
	]
	0
]

