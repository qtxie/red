test-container: func [
	name [c-string!]
	data [byte-ptr!]
	size magic expected-error expected-sections expected-offset expected-section [integer!]
	return: [integer!]
	/local result [wire-container-result!] actual [integer!]
][
	result: declare wire-container-result!
	actual: wire-container-reader/verify data size magic result
	if actual <> expected-error [
		print ["FAIL: " name " expected=" expected-error " actual=" actual lf]
		return 1
	]
	if all [
		expected-error = WIRE_CONTAINER_ERROR_SUCCESS
		result/section-count <> expected-sections
	][
		print ["FAIL: " name " section-count=" result/section-count lf]
		return 1
	]
	if any [
		result/error-offset <> expected-offset
		result/error-section <> expected-section
	][
		print [
			"FAIL: " name
			" location=" result/error-offset ":" result/error-section
			" expected=" expected-offset ":" expected-section lf
		]
		return 1
	]
	0
]

test-truncations: func [
	name [c-string!]
	data [byte-ptr!]
	size magic [integer!]
	return: [integer!]
	/local result [wire-container-result!] length code [integer!]
][
	result: declare wire-container-result!
	length: 0
	while [length < size][
		code: wire-container-reader/verify data length magic result
		if code = WIRE_CONTAINER_ERROR_SUCCESS [
			print ["FAIL: " name " accepted truncation=" length lf]
			return 1
		]
		length: length + 1
	]
	0
]

