			BAD_CHECKED_RESULT 51
			BAD_SHIFT_COUNT_TYPE 52
		]

		STATUS [
			SUCCESS 0
			INVALID_ARGUMENTS 1
			INVALID_CONFIGURATION 2
			INVALID_RSIR 3
			UNSUPPORTED_TARGET 4
			CODEGEN_FAILURE 5
			INVALID_ARTIFACT 6
		]

		DIAGNOSTIC_SEVERITY [
			NOTE 1
			WARNING 2
			ERROR 3
			FATAL 4
		]

		DIAGNOSTIC_PHASE [
			BRIDGE 1
			CONFIGURATION 2
			DECODE 3
			VERIFY 4
			OPTIMIZE 5
			SELECT 6
			ALLOCATE 7
			ENCODE 8
			ARTIFACT 9
		]

		DIAGNOSTIC_FLAG [
			FILE 1
			SOURCE 2
			FUNCTION 4
			INSTRUCTION 8
		]
	]

	profiles [
		RSCF [
			CONFIG RSCF_CONFIG REQUIRED ONE 4
		]

		RSIR [
			MODULE RSIR_MODULE REQUIRED ONE 4
