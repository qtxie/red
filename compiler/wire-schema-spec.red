		RSDG [
			STRINGS STRING REQUIRED NONEMPTY 4
			STRING_DATA BYTE REQUIRED NONEMPTY 1
			DIAGNOSTICS RSDG_DIAGNOSTIC REQUIRED NONEMPTY 4
		]
	]

