result: declare wire-scalar-operation-result!
strings: declare wire-string-table!
files: declare wire-file-source!
layout: declare wire-data-layout!
types: declare wire-type-layout!
functions: declare wire-function-signature!
modules: declare wire-module-lifecycle!
symbols: declare wire-symbol-linkage!
constants: declare wire-constant-initializer!
view: declare wire-scalar-operation!
code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	result strings files layout types functions modules symbols constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_SUCCESS [failures: failures + 1]
if any [
	strings/record-count <> 6
	files/file-count <> 0
	layout/pointer-size <> 8
	types/type-count <> 17
	functions/function-count <> 2
	modules/module-count <> 1
	symbols/symbol-count <> 2
	constants/constant-count <> 9
	view/value-count <> 71
	view/value-record-size <> WIRE_RSIR_VALUE_SIZE
	view/values-offset <> 2580
	view/values-ordinal <> 23
	view/instruction-count <> 66
	view/instruction-record-size <> WIRE_RSIR_INSTRUCTION_SIZE
	view/instructions-offset <> 4284
	view/instructions-ordinal <> 24
	view/operand-count <> 95
	view/operand-record-size <> WIRE_RSIR_OPERAND_SIZE
	view/operands-offset <> 7452
	view/operands-ordinal <> 25
	view/target-fragment-count <> 1
][
	print ["FAIL: verified scalar operation view changed" lf]
	failures: failures + 1
]

poison-outputs strings files layout types functions modules symbols constants view
code: wire-scalar-operation-reader/verify (as byte-ptr! 0) 9004
	result strings files layout types functions modules symbols constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
if any [
	result/error <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS
	result/container-error <> WIRE_CONTAINER_ERROR_SUCCESS
	result/string-error <> WIRE_STRING_TABLE_ERROR_SUCCESS
	result/file-source-error <> WIRE_FILE_SOURCE_ERROR_SUCCESS
	result/data-layout-error <> WIRE_DATA_LAYOUT_ERROR_SUCCESS
	result/type-layout-error <> WIRE_TYPE_LAYOUT_ERROR_SUCCESS
	result/function-signature-error <> WIRE_FUNCTION_SIGNATURE_ERROR_SUCCESS
	result/module-lifecycle-error <> WIRE_MODULE_LIFECYCLE_ERROR_SUCCESS
	result/symbol-linkage-error <> WIRE_SYMBOL_LINKAGE_ERROR_SUCCESS
	result/constant-initializer-error <> WIRE_CONSTANT_INITIALIZER_ERROR_SUCCESS
	result/error-offset <> 0
	result/error-section <> 0
][failures: failures + 1]
unless outputs-poisoned? strings files layout types functions modules symbols constants view [
	failures: failures + 1
]

code: wire-scalar-operation-reader/verify scalar-valid-rich -1 result
	strings files layout types functions modules symbols constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
unless outputs-poisoned? strings files layout types functions modules symbols constants view [
	failures: failures + 1
]
code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	result (as wire-string-table! 0) files layout types functions modules symbols constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	result strings (as wire-file-source! 0) layout types functions modules symbols constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	result strings files (as wire-data-layout! 0) types functions modules symbols constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	result strings files layout (as wire-type-layout! 0) functions modules symbols constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	result strings files layout types (as wire-function-signature! 0) modules symbols constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	result strings files layout types functions (as wire-module-lifecycle! 0) symbols constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	result strings files layout types functions modules (as wire-symbol-linkage! 0) constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	result strings files layout types functions modules symbols (as wire-constant-initializer! 0) view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	result strings files layout types functions modules symbols constants (as wire-scalar-operation! 0)
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]

code: wire-scalar-operation-reader/verify scalar-valid-rich 9004
	(as wire-scalar-operation-result! 0)
	strings files layout types functions modules symbols constants view
if code <> WIRE_SCALAR_OPERATION_ERROR_INVALID_ARGUMENTS [failures: failures + 1]

either failures = 0 [
	print ["PASS: Red/System RSIR scalar value and operation semantics" lf]
][
	print ["FAIL: Red/System RSIR scalar value and operation semantics failures=" failures lf]
]
quit failures
