	(wire-container-reader/read-i31 view/constants WIRE_RSIR_CONSTANT_KIND_OFFSET)
		<> WIRE_CONSTANT_KIND_SCALAR
	(wire-container-reader/read-i31 view/parts WIRE_RSIR_CONSTANT_PART_KIND_OFFSET)
		<> WIRE_CONSTANT_PART_KIND_CONSTANT_ADDRESS
	(wire-container-reader/read-i31 view/bindings WIRE_RSIR_CONSTANT_BINDING_SYMBOL_OFFSET)
		<> 1
	(wire-container-reader/read-i31 symbols/globals
		WIRE_RSIR_GLOBAL_INITIALIZER_CONSTANT_OFFSET) <> 1
][failures: failures + 1]

poison-outputs strings files layout types functions modules symbols view
code: wire-constant-initializer-reader/verify
	(as byte-ptr! 0) 2944
	result strings files layout types functions modules symbols view
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
if any [
	result/error <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS
	result/container-error <> WIRE_CONTAINER_ERROR_SUCCESS
	result/string-error <> WIRE_STRING_TABLE_ERROR_SUCCESS
	result/file-source-error <> WIRE_FILE_SOURCE_ERROR_SUCCESS
	result/data-layout-error <> WIRE_DATA_LAYOUT_ERROR_SUCCESS
	result/type-layout-error <> WIRE_TYPE_LAYOUT_ERROR_SUCCESS
	result/function-signature-error <> WIRE_FUNCTION_SIGNATURE_ERROR_SUCCESS
	result/module-lifecycle-error <> WIRE_MODULE_LIFECYCLE_ERROR_SUCCESS
	result/symbol-linkage-error <> WIRE_SYMBOL_LINKAGE_ERROR_SUCCESS
	result/error-offset <> 0
	result/error-section <> 0
][failures: failures + 1]
unless outputs-poisoned? strings files layout types functions modules symbols view [
	failures: failures + 1
]

code: wire-constant-initializer-reader/verify constant-valid-rich -1
	result strings files layout types functions modules symbols view
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
unless outputs-poisoned? strings files layout types functions modules symbols view [
	failures: failures + 1
]

code: wire-constant-initializer-reader/verify constant-valid-rich 2944
	result (as wire-string-table! 0) files layout types functions modules symbols view
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-constant-initializer-reader/verify constant-valid-rich 2944
	result strings (as wire-file-source! 0) layout types functions modules symbols view
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-constant-initializer-reader/verify constant-valid-rich 2944
	result strings files (as wire-data-layout! 0) types functions modules symbols view
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-constant-initializer-reader/verify constant-valid-rich 2944
	result strings files layout (as wire-type-layout! 0) functions modules symbols view
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-constant-initializer-reader/verify constant-valid-rich 2944
	result strings files layout types (as wire-function-signature! 0) modules symbols view
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-constant-initializer-reader/verify constant-valid-rich 2944
	result strings files layout types functions (as wire-module-lifecycle! 0) symbols view
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-constant-initializer-reader/verify constant-valid-rich 2944
	result strings files layout types functions modules (as wire-symbol-linkage! 0) view
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-constant-initializer-reader/verify constant-valid-rich 2944
	result strings files layout types functions modules symbols (as wire-constant-initializer! 0)
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]
code: wire-constant-initializer-reader/verify constant-valid-rich 2944
	(as wire-constant-initializer-result! 0)
	strings files layout types functions modules symbols view
if code <> WIRE_CONSTANT_INITIALIZER_ERROR_INVALID_ARGUMENTS [failures: failures + 1]

either failures = 0 [
	print ["PASS: Red/System RSIR constant/initializer semantics" lf]
][
	print ["FAIL: Red/System RSIR constant/initializer semantics failures=" failures lf]
]
quit failures
