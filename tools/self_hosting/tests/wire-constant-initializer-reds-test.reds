	]
]

test-constant-initializer: func [
	name [c-string!]
	data [byte-ptr!]
	size expected-error expected-container expected-string expected-file
	expected-layout expected-type expected-function expected-module expected-symbol
	expected-offset expected-section [integer!]
	return: [integer!]
	/local result [wire-constant-initializer-result!]
		strings [wire-string-table!]
		files [wire-file-source!]
		layout [wire-data-layout!]
		types [wire-type-layout!]
		functions [wire-function-signature!]
		modules [wire-module-lifecycle!]
		symbols [wire-symbol-linkage!]
		view [wire-constant-initializer!]
		actual [integer!]
][
	result: declare wire-constant-initializer-result!
	strings: declare wire-string-table!
	files: declare wire-file-source!
	layout: declare wire-data-layout!
	types: declare wire-type-layout!
	functions: declare wire-function-signature!
	modules: declare wire-module-lifecycle!
	symbols: declare wire-symbol-linkage!
	view: declare wire-constant-initializer!
	poison-outputs strings files layout types functions modules symbols view
	actual: wire-constant-initializer-reader/verify data size result
		strings files layout types functions modules symbols view
	if actual <> expected-error [
		print ["FAIL: " name " expected=" expected-error " actual=" actual lf]
		return 1
	]
	if result/error <> expected-error [
		print ["FAIL: " name " result/error=" result/error lf]
		return 1
	]
	if result/container-error <> expected-container [
		print ["FAIL: " name " container=" result/container-error lf]
		return 1
	]
	if result/string-error <> expected-string [
		print ["FAIL: " name " string=" result/string-error lf]
		return 1
	]
	if result/file-source-error <> expected-file [
		print ["FAIL: " name " file/source=" result/file-source-error lf]
		return 1
	]
	if result/data-layout-error <> expected-layout [
		print ["FAIL: " name " data-layout=" result/data-layout-error lf]
		return 1
	]
	if result/type-layout-error <> expected-type [
		print ["FAIL: " name " type-layout=" result/type-layout-error lf]
		return 1
	]
	if result/function-signature-error <> expected-function [
		print ["FAIL: " name " function/signature=" result/function-signature-error lf]
		return 1
	]
	if result/module-lifecycle-error <> expected-module [
		print ["FAIL: " name " module/lifecycle=" result/module-lifecycle-error lf]
		return 1
	]
	if result/symbol-linkage-error <> expected-symbol [
		print ["FAIL: " name " symbol/linkage=" result/symbol-linkage-error lf]
		return 1
	]
	if any [
		result/error-offset <> expected-offset
		result/error-section <> expected-section
	][
		print [
			"FAIL: " name
			" location=" result/error-offset ":" result/error-section
			" expected=" expected-offset ":" expected-section lf
		]
		return 1
	]
	if all [
		expected-error <> WIRE_CONSTANT_INITIALIZER_ERROR_SUCCESS
		not outputs-poisoned? strings files layout types functions modules symbols view
	][
		print ["FAIL: " name " modified output views on failure" lf]
		return 1
	]
	0
]

