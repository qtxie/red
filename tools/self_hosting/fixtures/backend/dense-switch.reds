Red/System [
	Title: "O2 x64 dense switch machine-IR coverage"
]

dense-switch: func [value [integer!] return: [integer!]][
	switch value [
		10 [1]
		12 [2]
		14 [3]
		16 [4]
		18 [5]
		20 [6]
		22 [7]
		24 [8]
		26 [9]
		28 [10]
		30 [11]
		32 [12]
		34 [13]
		36 [14]
		38 [15]
		40 [16]
		42 [17]
		44 [18]
		46 [19]
		48 [20]
		50 [21]
		52 [22]
		54 [23]
		56 [24]
		58 [25]
		60 [26]
		62 [27]
		64 [28]
		66 [29]
		68 [30]
		70 [31]
		72 [32]
		default [99]
	]
]

score: 0
if (dense-switch 9) = 99 [score: score + 1]
if (dense-switch 10) = 1 [score: score + 1]
if (dense-switch 11) = 99 [score: score + 1]
if (dense-switch 40) = 16 [score: score + 1]
if (dense-switch 41) = 99 [score: score + 1]
if (dense-switch 70) = 31 [score: score + 1]
if (dense-switch 72) = 32 [score: score + 1]
if (dense-switch 73) = 99 [score: score + 1]
print-line score
