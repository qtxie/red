test-module: func [
	name [c-string!]
	data [byte-ptr!]
	size magic expected-error expected-container expected-string expected-file
	expected-offset expected-section [integer!]
	return: [integer!]
	/local result [wire-module-lifecycle-result!]
		strings [wire-string-table!]
		files [wire-file-source!]
		view [wire-module-lifecycle!]
		actual [integer!]
][
	result: declare wire-module-lifecycle-result!
	strings: declare wire-string-table!
	files: declare wire-file-source!
	view: declare wire-module-lifecycle!
	poison-strings strings
	poison-files files
	poison-view view
	actual: wire-module-lifecycle-reader/verify
		data size magic result strings files view
	if actual <> expected-error [
		print ["FAIL: " name " expected=" expected-error " actual=" actual lf]
		return 1
	]
	if result/error <> expected-error [
		print ["FAIL: " name " result/error=" result/error lf]
		return 1
	]
	if result/container-error <> expected-container [
		print [
			"FAIL: " name " container=" result/container-error
			" expected=" expected-container lf
		]
		return 1
	]
	if result/string-error <> expected-string [
		print [
			"FAIL: " name " string=" result/string-error
			" expected=" expected-string lf
		]
		return 1
	]
	if result/file-source-error <> expected-file [
		print [
			"FAIL: " name " file=" result/file-source-error
			" expected=" expected-file lf
		]
		return 1
	]
	if any [
		result/error-offset <> expected-offset
		result/error-section <> expected-section
	][
		print [
			"FAIL: " name
			" location=" result/error-offset ":" result/error-section
			" expected=" expected-offset ":" expected-section lf
		]
		return 1
	]
	if all [
		expected-error <> WIRE_MODULE_LIFECYCLE_ERROR_SUCCESS
		any [
			not strings-poisoned? strings
			not files-poisoned? files
			not view-poisoned? view
		]
	][
		print ["FAIL: " name " modified output views on failure" lf]
		return 1
	]
	0
]

